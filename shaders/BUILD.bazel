genrule(
    name = "matmul_coop_bf16_spv_gen",
    srcs = ["//tools:emit_coop_spv.zig"],
    outs = [
        "matmul_coop_bf16.spv",
        "matmul_coop_bf16_spv.zig",
    ],
    cmd = """
set -euo pipefail
cache="$(@D)/zig-cache"
$(ZIG_BIN) run $(location //tools:emit_coop_spv.zig) \
    --cache-dir "$$cache" \
    --global-cache-dir "$$cache" \
    -- --mode=bf16 "$(@D)/matmul_coop_bf16.spv" "$(@D)/matmul_coop_bf16_spv.zig"
if spirv-val --target-env vulkan1.3 "$(@D)/matmul_coop_bf16.spv"; then
    :
else
    echo "warning: installed spirv-val does not recognize SPV_KHR_bfloat16 yet; generated BF16 SPIR-V was not validator-checked" >&2
fi
""",
    toolchains = ["@rules_zig//zig:resolved_toolchain"],
)

