genrule(
    name = "matmul_zig_spv",
    srcs = [
        "matmul_kernel.zig",
        "//tools:patch_spv.zig",
    ],
    outs = ["matmul_zig.spv"],
    cmd = """
set -euo pipefail
raw="$(@D)/matmul_zig.raw.spv"
cache="$(@D)/zig-cache"
$(ZIG_BIN) build-obj $(location matmul_kernel.zig) \
    -target spirv32-vulkan \
    -mcpu=vulkan_v1_2 \
    -fno-llvm \
    -fno-lld \
    -fno-entry \
    --cache-dir "$$cache" \
    --global-cache-dir "$$cache" \
    -femit-bin="$$raw"
$(ZIG_BIN) run $(location //tools:patch_spv.zig) \
    --cache-dir "$$cache" \
    --global-cache-dir "$$cache" \
    -- "$$raw" "$@"
""",
    toolchains = ["@rules_zig//zig:resolved_toolchain"],
    visibility = ["//visibility:public"],
)

